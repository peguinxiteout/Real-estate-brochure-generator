  },
  "additionalProperties": false,
  "properties": {
    "template_id": {
      "title": "Template Id",
      "type": "string"
    },
    "name": {
      "default": "",
      "title": "Name",
      "type": "string"
    },
    "slots": {
      "items": {
        "$ref": "#/$defs/Slot"
      },
      "title": "Slots",
      "type": "array"
    }
  },
  "required": [
    "template_id",
    "slots"
